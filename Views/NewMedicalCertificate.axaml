<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CourseWork.Controls"
        x:Class="CourseWork.Views.NewMedicalCertificate"
        Icon="/Assets/flag.png"
        Title="Создание акта медицинского освидетельствования"
        WindowState="Maximized"
        Background="#F5F7FA">

    <Grid RowDefinitions="*, Auto" ColumnDefinitions="200, *">
        
        <controls:LeftPanel x:Name="LeftPanelControl" 
                            Grid.Column="0" 
                            Grid.Row="0" 
                            Grid.RowSpan="2"/>

        <ScrollViewer Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Border Background="#F8F9FA" Padding="40">
                <StackPanel Spacing="25" MaxWidth="700" HorizontalAlignment="Left">
                    
                    <TextBlock Text="Акт медицинского освидетельствования" 
                               FontSize="28" FontWeight="SemiBold" Foreground="#1E2A3A"/>

                    <!-- Направление -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Направление *" FontSize="14" FontWeight="SemiBold" Foreground="#0F4B5E"/>
                        <StackPanel Spacing="8" Orientation="Horizontal">
                            <TextBox x:Name="txt_examinationReport" Height="44" IsReadOnly="True"
                                     Watermark="Выберите направление..." 
                                     VerticalContentAlignment="Center"
                                     Background="White" BorderBrush="#E9ECEF" 
                                     CornerRadius="8" Width="230"/>
                            <Button x:Name="btn_selectReport" Content="Выбрать" Width="100" Height="44" 
                                    Background="#0F4B5E" Foreground="White" CornerRadius="8" FontSize="14"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Номер акта -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Номер акта *" FontSize="14" FontWeight="SemiBold" Foreground="#0F4B5E"/>
                        <TextBox x:Name="txt_number" Height="44" Watermark="Введите номер"
                                 BorderBrush="#E9ECEF" CornerRadius="8"/>
                    </StackPanel>

                    <!-- Дата и время осмотра -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Дата и время осмотра *" FontSize="14" FontWeight="SemiBold" Foreground="#0F4B5E"/>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <DatePicker x:Name="dp_date" 
                                        Height="44"
                                        Width="220"
                                        FontSize="14"
                                        CornerRadius="8"/>
                            
                            <TimePicker x:Name="tp_time" 
                                        Height="44"
                                        Width="160"
                                        FontSize="14"
                                        ClockIdentifier="24HourClock"
                                        CornerRadius="8"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Признаки опьянения -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Признаки опьянения" FontSize="14" FontWeight="SemiBold" Foreground="#0F4B5E"/>
                        <TextBox x:Name="txt_signs" Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                                 Watermark="Запах алкоголя, неустойчивость позы..." BorderBrush="#E9ECEF" CornerRadius="8"/>
                    </StackPanel>

                    <!-- Тип опьянения (ComboBox) -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Тип опьянения" FontSize="14" FontWeight="SemiBold" Foreground="#0F4B5E"/>
                        <ComboBox x:Name="cmb_intoxication_type" Height="44" CornerRadius="8" SelectedIndex="0">
                            <ComboBoxItem Content="Алкогольное"/>
                            <ComboBoxItem Content="Наркотическое"/>
                            <ComboBoxItem Content="Токсическое"/>
                            <ComboBoxItem Content="Не выявлено"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Результат (TextBox) -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Результат *" FontSize="14" FontWeight="SemiBold" Foreground="#0F4B5E"/>
                        <TextBox x:Name="txt_result" Height="100" Watermark=""
                                 BorderBrush="#E9ECEF" CornerRadius="8"/>
                    </StackPanel>

                    <!-- Подпись врача -->
                    <CheckBox x:Name="chk_signature" Content="Подпись врача" FontSize="14"/>

                    <!-- Кнопки -->
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,16,0,0">
                        <Button x:Name="btn_cancel" Content="Отмена" Width="120" Height="44"
                                Background="#6C757D" Foreground="White" CornerRadius="8" FontSize="14"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button x:Name="btn_save_draft" Content="Сохранить как черновик" Width="195" Height="44"
                                Background="#6C757D" Foreground="White" CornerRadius="8" FontSize="14"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button x:Name="btn_create" Content="Создать" Width="120" Height="44"
                                Background="#0F4B5E" Foreground="White" CornerRadius="8" FontSize="14"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <controls:NotificationsControl x:Name="NotificationsControl" 
                                       Grid.Column="0" 
                                       Grid.ColumnSpan="2"
                                       Grid.Row="1"      
                                       VerticalAlignment="Bottom"/>
    </Grid>
</Window>