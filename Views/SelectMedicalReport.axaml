<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CourseWork.Controls"
        x:Class="CourseWork.Views.SelectMedicalReport"
        Title="Выбор направления на медосвидетельствование"
        WindowState="Maximized"
        Background="#F5F7FA">

    <Grid Margin="20">
        <Border Background="White"
                CornerRadius="16"
                BoxShadow="0 4 12 #1000000A">
            
            <Grid RowDefinitions="Auto, Auto, Auto, *">
                
                <StackPanel Grid.Row="0" Margin="24,24,24,16" Spacing="8">
                    <TextBlock Text="Выбор направления" FontSize="24" FontWeight="SemiBold" Foreground="#1E2A3A"/>
                    <TextBlock Text="Заполните поля для поиска направления" FontSize="13" Foreground="#6C757D"/>
                </StackPanel>
                
                <Border Grid.Row="1" Margin="24,0,24,16" Background="#F8F9FA" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="12">
                        
                    <!-- Гражданин с кнопкой "Выбрать" справа -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Гражданин" FontSize="13" FontWeight="SemiBold" Foreground="#0F4B5E"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="txt_citizen" 
                                            Width="400"
                                            Height="38" 
                                            IsReadOnly="True"
                                            Watermark="Гражданин не выбран..." 
                                            Background="#F8F9FA" 
                                            CornerRadius="6"
                                            HorizontalAlignment="Left"
                                            VerticalContentAlignment="Center"/>
                                    <Button x:Name="btn_select_citizen" 
                                            Content="Выбрать" 
                                            Height="38"
                                            Width="100"
                                            Background="#0F4B5E" 
                                            Foreground="White" 
                                            CornerRadius="6" 
                                            FontSize="14"
                                            HorizontalContentAlignment="Center" 
                                            VerticalContentAlignment="Center" Margin="10"/>
                                </StackPanel>
                        </StackPanel>

                        <!-- Дата составления -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Дата составления" FontSize="12" FontWeight="SemiBold" Foreground="#0F4B5E"/>
                            <DatePicker x:Name="dp_date" Height="36" CornerRadius="6" Width="200" HorizontalAlignment="Left"/>
                        </StackPanel>
                        
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <Button Content="← Назад" 
                                    Height="36" 
                                    Width="95"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="#6C757D" 
                                    Foreground="White" 
                                    FontSize="14" 
                                    CornerRadius="8" 
                                    x:Name="btn_cancel"/>
                            
                            <Button Grid.Column="1" 
                                    Content="Найти" 
                                    Height="36" 
                                    Width="85"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="#0F4B5E" 
                                    Foreground="White" 
                                    FontSize="14" 
                                    CornerRadius="8" 
                                    x:Name="btn_search"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <TextBlock Grid.Row="2" Margin="24,8,24,8" Text="Результаты поиска:" FontSize="14" FontWeight="SemiBold" Foreground="#0F4B5E"/>
                
                <ScrollViewer Grid.Row="3" Margin="24,0,24,24" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="reportsContainer">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        CornerRadius="12"
                                        BorderBrush="#E9ECEF"
                                        BorderThickness="1"
                                        Padding="16,14"
                                        Margin="0,0,0,12"
                                        Cursor="Hand">
                                    
                                    <Grid ColumnDefinitions="*, Auto">
                                        
                                        <StackPanel Grid.Column="0" Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Number, StringFormat='№ {0}'}" FontSize="16" FontWeight="SemiBold" Foreground="#1E2A3A"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding PatientFullName}" FontSize="14" Foreground="#1E2A3A"/>
                                            <StackPanel Orientation="Horizontal" Spacing="15">
                                                <TextBlock Text="{Binding MakingDate, StringFormat='dd.MM.yyyy HH:mm'}" FontSize="12" Foreground="#6C757D"/>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <Button Grid.Column="1"
                                                Content="Выбрать →"
                                                Background="#0F4B5E"
                                                Foreground="White"
                                                CornerRadius="8"
                                                Padding="20,10"
                                                FontSize="13"
                                                Tag="{Binding}"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                x:Name="btnSelect"
                                                Click="btnSelect_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <Border Grid.Row="3"
                        Background="White"
                        IsVisible="False"
                        x:Name="emptyStateBorder"
                        VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                        <TextBlock Text="📋" FontSize="64"/>
                        <TextBlock Text="Направления не найдены" FontSize="18" Foreground="#6C757D"/>
                    </StackPanel>
                </Border>
                
            </Grid>
        </Border>
    </Grid>
</Window>