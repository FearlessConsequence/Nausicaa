<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="CourseWork.Views.MainWindow"
        Icon="/Assets/flag.png"
        xmlns:controls="using:CourseWork.Controls"
        Title="Главная"
        WindowState="Maximized">

    <Grid RowDefinitions="*, Auto" ColumnDefinitions="200, *">
        
        <controls:LeftPanel x:Name="LeftPanelControl" 
                    Grid.Column="0" 
                    Grid.Row="0" 
                    Grid.RowSpan="2"/>

        <Border Grid.Column="1" Grid.Row="0" Background="White" BorderBrush="#eae9ef" 
                BorderThickness="0, 0, 0, 1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Панель быстрого создания документа -->
                <StackPanel Grid.Row="0" Margin="0, 20">
                    <TextBlock Text="Быстрое создание документа:" 
                            HorizontalAlignment="Center" 
                            Foreground="#0F4B5E" FontWeight="SemiBold" 
                            Margin="20, 10, 20, 15" FontSize="18"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Обращение -->
                        <Button Width="130" x:Name="btn_newAppel" Height="130" Margin="8" 
                                Background="#F3F3F3" BorderThickness="0" CornerRadius="8"
                                Padding="10">
                            <TextBlock Text="Обращение" 
                                    FontWeight="SemiBold" FontSize="15" 
                                    Foreground="#0F4B5E" 
                                    TextAlignment="Center" 
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                        </Button>
                        
                        <!-- Заявление -->
                        <Button Width="130" x:Name="btn_newStatement" Height="130" Margin="8"
                                Background="#F3F3F3" BorderThickness="0" CornerRadius="8"
                                Padding="10">
                            <TextBlock Text="Заявление" 
                                    FontWeight="SemiBold" FontSize="15" 
                                    Foreground="#0F4B5E" 
                                    TextAlignment="Center" 
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                        </Button>
                        
                        <!-- Протокол объяснения -->
                        <Button Width="130" x:Name="btn_newExplanationProtocol" Height="130" Margin="8" 
                                Background="#F3F3F3" BorderThickness="0" CornerRadius="8"
                                Padding="10">
                            <TextBlock Text="Протокол объяснения" 
                                    FontWeight="SemiBold" FontSize="14" 
                                    Foreground="#0F4B5E" 
                                    TextAlignment="Center" 
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                        </Button>
                        
                        <!-- Направление на мед. освид. -->
                        <Button Width="130" x:Name="btn_newExaminationReport" Height="130" Margin="8" 
                                Background="#F3F3F3" BorderThickness="0" CornerRadius="8"
                                Padding="10">
                            <TextBlock Text="Направление на мед. освид." 
                                    FontWeight="SemiBold" FontSize="13" 
                                    Foreground="#0F4B5E" 
                                    TextAlignment="Center" 
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                        </Button>
                        
                        <!-- Адм. протокол -->
                        <Button Width="130" x:Name="btn_newAdministrativeProtocol" Height="130" Margin="8" 
                                Background="#F3F3F3" BorderThickness="0" CornerRadius="8"
                                Padding="10">
                            <TextBlock Text="Административный протокол" 
                                    FontWeight="SemiBold" FontSize="13" 
                                    Foreground="#0F4B5E" 
                                    TextAlignment="Center" 
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                        </Button>
                                    
                        <!-- Кнопка для врача -->
                        <Button Width="130" x:Name="btn_newMedicalCertificate" Height="130" Margin="8" 
                                Background="#F3F3F3" Foreground="#0F4B5E" BorderThickness="0" CornerRadius="8"
                                IsVisible="False" Content="Акт мед. освид." FontWeight="SemiBold" FontSize="14"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                        <!-- Кнопка для судьи -->
                        <Button Width="140" x:Name="btn_newResolution" Height="140" Margin="8" 
                                Background="#F3F3F3" Foreground="#0F4B5E" BorderThickness="0" CornerRadius="8"
                                IsVisible="False" Content="Постановление" FontWeight="SemiBold" FontSize="15"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                        <!-- Кнопка для эксперта -->
                        <Button Width="140" x:Name="btn_newForensicExpertise" Height="140" Margin="8" 
                                Background="#F3F3F3" Foreground="#0F4B5E" BorderThickness="0" CornerRadius="8"
                                IsVisible="False" FontWeight="SemiBold" FontSize="15"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <Button.Content>
                                <TextBlock Text="Судебная&#x0a;экспертиза" TextAlignment="Center"/>
                            </Button.Content>
                        </Button>

                        <!-- Кнопка для инспектора - Дело -->
                        <Button Width="130" x:Name="btn_newDeal" Height="130" Margin="8" 
                                Background="#F3F3F3" Foreground="#0F4B5E" BorderThickness="0" CornerRadius="8"
                                IsVisible="False" FontWeight="SemiBold" FontSize="14"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <TextBlock Text="Дело" 
                                    FontWeight="SemiBold" FontSize="15" 
                                    Foreground="#0F4B5E" 
                                    TextAlignment="Center" 
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                        </Button>

                        <!-- Кнопка для инспектора - Гражданин -->
                        <Button Width="130" x:Name="btn_newCitizen" Height="130" Margin="8" 
                                Background="#F3F3F3" Foreground="#0F4B5E" BorderThickness="0" CornerRadius="8"
                                IsVisible="False" FontWeight="SemiBold" FontSize="14"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <TextBlock Text="Гражданин" 
                                    FontWeight="SemiBold" FontSize="15" 
                                    Foreground="#0F4B5E" 
                                    TextAlignment="Center" 
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Background="White" BorderBrush="LightGray" 
                        BorderThickness="1" BoxShadow="0 0 15 3 #80808080" CornerRadius="4" 
                        Margin="20,0,20,0" Padding="15,12">
                    <StackPanel Spacing="15">
    
                        <!-- Блок поиска гражданина -->
                        <Border Background="#F8F9FA" CornerRadius="8" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="🔍 Поиск гражданина" FontWeight="Bold" FontSize="14" Foreground="#0F4B5E"/>
                                
                                <Grid ColumnDefinitions="*, *, *, *, *, Auto" ColumnSpacing="15">
                                    <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="4">
                                        <TextBlock Text="Паспорт:" FontSize="11" Foreground="#0F4B5E"/>
                                        <TextBox Height="32" Watermark="00 00 123456" x:Name="txbx_citizen_passport" FontSize="12"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4">
                                        <TextBlock Text="ФИО:" FontSize="11" Foreground="#0F4B5E"/>
                                        <TextBox Height="32" Watermark="Иванов Иван Иванович" x:Name="txbx_citizen_fio" FontSize="12"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="4">
                                        <TextBlock Text="Дата рождения:" FontSize="11" Foreground="#0F4B5E"/>
                                        <DatePicker Height="32" x:Name="dp_citizen_birthday" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Vertical" Spacing="4" Margin="10,0,0,0">
                                        <TextBlock Text="Телефон:" FontSize="11" Foreground="#0F4B5E"/>
                                        <TextBox Height="32" Watermark="+7 999 123-45-67" x:Name="txbx_citizen_phone" FontSize="12"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="4" Orientation="Vertical" Spacing="4">
                                        <TextBlock Text="Адрес:" FontSize="11" Foreground="#0F4B5E"/>
                                        <TextBox Height="32" Watermark="г. Москва, ул. Пушкина, д. 10" x:Name="txbx_citizen_address" FontSize="12"/>
                                    </StackPanel>
                                    
                                    <Button Grid.Column="5" Content="Найти гражданина" Height="32" 
                                            Background="#0F4B5E" Foreground="White" CornerRadius="4" 
                                            FontSize="14" x:Name="btn_citizen_search" 
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                                            Margin="0,18,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Поиск документов по ролям -->

                        <!-- Для полицейского -->
                        <Border x:Name="DocSearchPolice" CornerRadius="8" Padding="12" IsVisible="True">
                            <StackPanel Spacing="12">
                                <TextBlock Text="📄 Поиск документа" FontWeight="Bold" FontSize="14" Foreground="#0F4B5E"/>
                                
                                <Grid ColumnDefinitions="*, *, *, Auto, Auto" ColumnSpacing="15">
                                    <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="4">
                                        <TextBlock Text="Номер документа:" FontSize="11" Foreground="#0F4B5E"/>
                                        <TextBox Height="32" Watermark="Введите номер документа" x:Name="txbx_police_doc_number" FontSize="12"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4">
                                        <TextBlock Text="Тип документа:" FontSize="11" Foreground="#0F4B5E"/>
                                        <ComboBox Height="32" x:Name="cmb_police_doc_type" FontSize="12" SelectedIndex="0"
                                                HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Любой"/>
                                            <ComboBoxItem Content="Обращение"/>
                                            <ComboBoxItem Content="Заявление"/>
                                            <ComboBoxItem Content="Протокол объяснения"/>
                                            <ComboBoxItem Content="Направление на мед. освид."/>
                                            <ComboBoxItem Content="Административный протокол"/>
                                            <ComboBoxItem Content="Акт медицинского освидетельствования"/>
                                            <ComboBoxItem Content="Судебно-медицинская экспертиза"/>
                                            <ComboBoxItem Content="Постановление"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="4">
                                        <TextBlock Text="Дата составления:" FontSize="11" Foreground="#0F4B5E"/>
                                        <DatePicker Height="32" x:Name="dp_police_doc_date" FontSize="12"/>
                                    </StackPanel>
                                    
                                    <CheckBox Grid.Column="3" Content="Искать по гражданину" VerticalAlignment="Center" 
                                            x:Name="chk_police_search_doc" FontSize="12" Margin="0,16,40,0"/>
                                    
                                    <Button Grid.Column="4" Content="Найти документ" Height="32" 
                                            Background="#0F4B5E" Foreground="White" CornerRadius="4" 
                                            FontSize="14" x:Name="btn_police_doc_search" 
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="140"
                                            Margin="0,16,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Для врача -->
                        <Border x:Name="DocSearchDoctor" CornerRadius="8" Padding="12" IsVisible="False">
                            <StackPanel Spacing="10">
                                <TextBlock Text="📄 Поиск актов и направлений на медицинское освидетельствование" FontWeight="Bold" FontSize="14" Foreground="#0F4B5E"/>
                                <Grid ColumnDefinitions="1.2*, 1.2*, 1.2*, Auto, Auto" ColumnSpacing="10">
                                    <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="4">
                                        <TextBlock Text="Номер направления:" FontSize="11" Foreground="#0F4B5E"/>
                                        <TextBox Height="32" Watermark="Номер" x:Name="txbx_doctor_report_number" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4">
                                        <TextBlock Text="Номер акта:" FontSize="11" Foreground="#0F4B5E"/>
                                        <TextBox Height="32" Watermark="Номер акта" x:Name="txbx_doctor_cert_number" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="4">
                                        <TextBlock Text="Дата составления:" FontSize="11" Foreground="#0F4B5E"/>
                                        <DatePicker Height="32" x:Name="dp_doctor_doc_date" FontSize="12"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="3" Content="Искать по гражданину" VerticalAlignment="Center" 
                                            x:Name="chk_doctor_search_doc" FontSize="12" Margin="0,16,60,0"/>
                                    <Button Grid.Column="4" Content="Найти документ" Width="140" Height="32" 
                                            Background="#0F4B5E" Foreground="White" CornerRadius="4" 
                                            FontSize="14" x:Name="btn_doctor_doc_search" VerticalAlignment="Bottom"
                                            Margin="0,16,0,0" HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Для судьи -->
                        <Border x:Name="DocSearchJudge" CornerRadius="8" Padding="12" IsVisible="False">
                            <StackPanel Spacing="10">
                                <TextBlock Text="📄 Поиск документов" FontWeight="Bold" FontSize="14" Foreground="#0F4B5E"/>
                                
                                <Grid ColumnDefinitions="1.5*, 1*, 1*, Auto, Auto" ColumnSpacing="8">
                                    
                                    <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="4">
                                        <TextBlock Text="Тип документа:" FontSize="11" Foreground="#0F4B5E"/>
                                        <ComboBox x:Name="cmb_judge_doc_type" 
                                                Height="32" 
                                                FontSize="12" 
                                                SelectedIndex="0"
                                                HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Все"/>
                                            <ComboBoxItem Content="Обращение"/>
                                            <ComboBoxItem Content="Заявление"/>
                                            <ComboBoxItem Content="Протокол объяснения"/>
                                            <ComboBoxItem Content="Направление на мед. освид."/>
                                            <ComboBoxItem Content="Административный протокол"/>
                                            <ComboBoxItem Content="Акт медицинского освидетельствования"/>
                                            <ComboBoxItem Content="Судебно-медицинская экспертиза"/>
                                            <ComboBoxItem Content="Постановление"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4">
                                        <TextBlock Text="Номер документа:" FontSize="11" Foreground="#0F4B5E"/>
                                        <TextBox Height="32" Watermark="Номер" x:Name="txbx_judge_number" FontSize="12"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="4">
                                        <TextBlock Text="Дата:" FontSize="11" Foreground="#0F4B5E"/>
                                        <DatePicker Height="32" x:Name="dp_judge_doc_date" FontSize="12"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,18,20,0">
                                        <CheckBox Content="Искать по гражданину" 
                                                x:Name="chk_judge_search_doc" 
                                                FontSize="13"/>
                                    </StackPanel>
                                    
                                    <Button Grid.Column="4" 
                                            Content="Найти документ" 
                                            Width="130" 
                                            Height="32" 
                                            Background="#0F4B5E" 
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Foreground="White" 
                                            CornerRadius="4" 
                                            FontSize="14" 
                                            x:Name="btn_judge_doc_search" 
                                            VerticalAlignment="Bottom"
                                            Margin="0,18,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Для эксперта -->
                        <Border x:Name="DocSearchForensic" CornerRadius="8" Padding="12" IsVisible="False">
                            <StackPanel Spacing="10">
                                <TextBlock Text="📄 Поиск экспертизы" FontWeight="Bold" FontSize="14" Foreground="#0F4B5E"/>
                                
                                <Grid ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="15">
                                    
                                    <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="4">
                                        <TextBlock Text="Номер экспертизы:" FontSize="11" Foreground="#0F4B5E"/>
                                        <TextBox Height="32" Watermark="Номер" x:Name="txbx_forensic_number" FontSize="12"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4">
                                        <TextBlock Text="Дата составления:" FontSize="11" Foreground="#0F4B5E"/>
                                        <DatePicker Height="32" Width="140" x:Name="dp_forensic_doc_date" FontSize="12"/>
                                    </StackPanel>
                                    
                                    <CheckBox Grid.Column="2" Content="Искать по гражданину" VerticalAlignment="Center" 
                                            x:Name="chk_forensic_search_doc" FontSize="12" Margin="10,18,0,0"/>
                                    
                                    <Button Grid.Column="3" Content="Найти документ" Width="130" Height="32" 
                                            Background="#0F4B5E" Foreground="White" CornerRadius="4" 
                                            FontSize="14" x:Name="btn_forensic_doc_search" 
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Margin="0,18,0,0"/>
                                    
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- Блок недавних и черновиков -->
                <Grid Grid.Row="2" Margin="20,20,20,20" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" 
                            BorderBrush="LightGray" BorderThickness="1" 
                            BoxShadow="0 0 15 3 #80808080" CornerRadius="8" Padding="15">
                        <Grid RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="Недавние документы" FontWeight="Bold" FontSize="17" Foreground="#0F4B5E" Margin="0,0,0,15"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="400">
                                <StackPanel>
                                    <ItemsControl x:Name="recentDocumentsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8F9FA" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                                            <TextBlock Text="{Binding DocumentTypeIcon}" FontSize="16"/>
                                                            <TextBlock Text="{Binding DocumentName}" FontSize="13" FontWeight="SemiBold" Foreground="#1E2A3A"/>
                                                            <TextBlock Text="{Binding LastOpenedDateFormatted}" FontSize="11" Foreground="#6C757D"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="→" Width="30" Height="30"
                                                                Background="#0F4B5E" Foreground="White" CornerRadius="4"
                                                                FontSize="14" Tag="{Binding}" Cursor="Hand" x:Name="btnOpenRecent"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="txtNoRecent" Text="Нет недавних документов" 
                                            FontSize="13" Foreground="#6C757D" HorizontalAlignment="Center"
                                            Margin="0,20,0,0" IsVisible="False"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="White" 
                            BorderBrush="LightGray" BorderThickness="1" 
                            BoxShadow="0 0 15 3 #80808080" CornerRadius="8" Padding="15">
                        <Grid RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="Черновики" FontWeight="Bold" FontSize="17" Foreground="#0F4B5E" Margin="0,0,0,15"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="400">
                                <StackPanel>
                                    <ItemsControl x:Name="draftsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8F9FA" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                                            <TextBlock Text="📄" FontSize="16"/>
                                                            <TextBlock Text="{Binding TypeDisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="#1E2A3A"/>
                                                            <TextBlock Text="{Binding DateFormatted}" FontSize="11" Foreground="#6C757D"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="→" Width="30" Height="30"
                                                                Background="#0F4B5E" Foreground="White" CornerRadius="4"
                                                                FontSize="14" Tag="{Binding}" Cursor="Hand" x:Name="btnOpenDraft"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="txtNoDrafts" Text="Нет черновиков" 
                                            FontSize="13" Foreground="#6C757D" HorizontalAlignment="Center"
                                            Margin="0,20,0,0" IsVisible="False"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    
        <!-- UserControl нижней панели уведомлений -->
        <controls:NotificationsControl x:Name="NotificationsControl" 
                                Grid.Column="0" 
                                Grid.ColumnSpan="2"
                                Grid.Row="1"      
                                VerticalAlignment="Bottom"/>
    </Grid>
</Window>