<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CourseWork.Views.StatisticsWindow"
        Title="Статистика"
        WindowState="Maximized"
        Icon="/Assets/flag.png"
        xmlns:controls="using:CourseWork.Controls"
        Background="#F5F7FA">

    <Grid RowDefinitions="*, Auto" ColumnDefinitions="200, *">
        
        <controls:LeftPanel x:Name="LeftPanelControl" 
                            Grid.Column="0" 
                            Grid.Row="0" 
                            Grid.RowSpan="2"/>

        <ScrollViewer Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Border Background="#F8F9FA" Padding="30">
                
                <StackPanel Spacing="25">
                    
                    <TextBlock Text="Статистика" 
                               FontSize="28" 
                               FontWeight="SemiBold"
                               Foreground="#1E2A3A"
                               HorizontalAlignment="Center"/>
                    
                    <!-- Верхний блок с общей статистикой (по центру) -->
                    <Border Background="White" CornerRadius="12" BorderBrush="#E9ECEF" BorderThickness="1" Padding="20">
                        <StackPanel HorizontalAlignment="Center" Spacing="40" Orientation="Horizontal">
                            <StackPanel HorizontalAlignment="Center" Spacing="5">
                                <TextBlock x:Name="txt_total_deals" Text="0" FontSize="28" FontWeight="Bold" Foreground="#0F4B5E" HorizontalAlignment="Center"/>
                                <TextBlock Text="Всего дел" FontSize="13" Foreground="#6C757D" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" Spacing="5">
                                <TextBlock x:Name="txt_completed" Text="0" FontSize="28" FontWeight="Bold" Foreground="#28A745" HorizontalAlignment="Center"/>
                                <TextBlock Text="Завершено" FontSize="13" Foreground="#6C757D" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" Spacing="5">
                                <TextBlock x:Name="txt_in_progress" Text="0" FontSize="28" FontWeight="Bold" Foreground="#DC3545" HorizontalAlignment="Center"/>
                                <TextBlock Text="В процессе" FontSize="13" Foreground="#6C757D" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Фильтры -->
                    <Border Background="White" CornerRadius="12" BorderBrush="#E9ECEF" BorderThickness="1" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="Фильтры" FontSize="16" FontWeight="SemiBold" Foreground="#0F4B5E"/>
                            
                            <!-- Дата -->
                            <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,15,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Дата от:" VerticalAlignment="Center" 
                                    FontSize="14" Foreground="#1E2A3A" Width="60"/>
                                    <DatePicker x:Name="dp_date_from" Width="140" Height="35" Margin="27,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Дата до:" VerticalAlignment="Center" FontSize="14" Foreground="#1E2A3A" Width="60"/>
                                    <DatePicker x:Name="dp_date_to" Width="140" Height="35"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Сотрудник -->
                            <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,15,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Сотрудник:" VerticalAlignment="Center" FontSize="14" Foreground="#1E2A3A" Width="90"/>
                                    <TextBox x:Name="txt_officer" Width="220" Height="35"
                                             Watermark="Не выбран" IsReadOnly="True" FontSize="14"/>
                                </StackPanel>
                                <Button Content="Выбрать сотрудника" 
                                        x:Name="btn_select_officer" Height="35" Padding="15,0"
                                        Background="#0F4B5E" Foreground="White" CornerRadius="6" FontSize="14"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Статья -->
                            <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,15,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Статья КоАП:" VerticalAlignment="Center" FontSize="14" Foreground="#1E2A3A" Width="90"/>
                                    <TextBox x:Name="txt_article" Width="180" Height="35" Watermark="Например: 12.8" FontSize="14"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Кнопки -->
                            <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,15,0,0">
                                <Button Content="Применить" 
                                        x:Name="btn_apply_filters" Height="40" Width="120"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="#0F4B5E" Foreground="White" 
                                        CornerRadius="6" FontSize="14"/>
                                <Button Content="Сбросить фильтры" 
                                        x:Name="btn_clear_filters" Height="40" Width="160"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="#6C757D" Foreground="White" 
                                        CornerRadius="6" FontSize="14"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Результат фильтрации (количество) -->
                    <Border x:Name="filterResultBorder" Background="White" CornerRadius="12" BorderBrush="#E9ECEF" BorderThickness="1" Padding="20" IsVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <TextBlock Text="Найдено дел:" FontSize="16" FontWeight="SemiBold" Foreground="#0F4B5E"/>
                            <TextBlock x:Name="txt_filter_result" Text="0" FontSize="16" FontWeight="Bold" Foreground="#0F4B5E"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Таблица дел с прокруткой -->
                    <Border Background="White" CornerRadius="12" BorderBrush="#E9ECEF" BorderThickness="1" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="Список дел" FontSize="16" FontWeight="SemiBold" Foreground="#0F4B5E"/>
                            
                            <!-- Заголовки таблицы -->
                            <Border Background="#F8F9FA" CornerRadius="8" Padding="12">
                                <Grid ColumnDefinitions="1.2*, 2*, 2*, 1.5*" ColumnSpacing="15">
                                    <TextBlock Text="Дело" FontSize="13" FontWeight="SemiBold" Foreground="#0F4B5E"/>
                                    <TextBlock Text="Статья" FontSize="13" FontWeight="SemiBold" Foreground="#0F4B5E" Grid.Column="1"/>
                                    <TextBlock Text="Сотрудник" FontSize="13" FontWeight="SemiBold" Foreground="#0F4B5E" Grid.Column="2"/>
                                    <TextBlock Text="Дата" FontSize="13" FontWeight="SemiBold" Foreground="#0F4B5E" Grid.Column="3" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            
                            <!-- Список дел с прокруткой -->
                            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="dealsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" Padding="12,10">
                                                <Grid ColumnDefinitions="1.2*, 2*, 2*, 1.5*" ColumnSpacing="15">
                                                    <TextBlock Text="{Binding DealNumber}" FontSize="13" Foreground="#1E2A3A"/>
                                                    <TextBlock Text="{Binding ArticleName}" FontSize="13" Foreground="#1E2A3A" Grid.Column="1"/>
                                                    <TextBlock Text="{Binding OfficerName}" FontSize="13" Foreground="#1E2A3A" Grid.Column="2"/>
                                                    <TextBlock Text="{Binding DateFormatted}" FontSize="13" Foreground="#1E2A3A" Grid.Column="3" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </Border>
        </ScrollViewer>

        <controls:NotificationsControl x:Name="NotificationsControl" 
                                       Grid.Column="0" 
                                       Grid.ColumnSpan="2"
                                       Grid.Row="1"      
                                       VerticalAlignment="Bottom"/>
    </Grid>
</Window>